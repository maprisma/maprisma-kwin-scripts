/*
 * Maprisma Tiling: KWin 6 tiling with Omarchy's (Hyprland's) behaviour and
 * keys, driven by Maprisma Theme. The layouts live in engine.js, which
 * install.sh puts in place of the ENGINE marker below (KWin caches QML and
 * its imports by URL, so the engine travels inside this file).
 *
 * Settings: kwinrc [Script-maprisma-tiling], re-read when KWin reconfigures:
 *   untiledDesktops   desktop indices left alone ("3,5")
 *   gapTop/Right/Bottom/Left, gapBetween   pixels
 *   borderWidth, borderColor, cornerRadius the active window frame
 *   limitsActive, defaultLimit, limits ("1:2,3:3")   tiles per desktop
 *   floatingClasses   app ids that always float
 *   defaultLayout     dwindle | master | columns | monocle
 * The frame and the group tab bars are drawn by maprisma-tiling-overlay
 * (a layer-shell helper, started over D-Bus): KWin's own QML windows come
 * out at the wrong scale.
 */
import QtQuick
import QtQml.Models
import org.kde.kwin
import org.kde.plasma.workspace.dbus as DBus

Item {
    id: root

    readonly property var eng: (function () {
//@ENGINE@
        return Engine;
    })()

    // --- settings ------------------------------------------------------------

    property var cfg: ({})
    property string cfgText: ""

    function readCfg() {
        function num(key, dflt, lo, hi) {
            var v = Number(KWin.readConfig(key, dflt));
            return isNaN(v) ? dflt : Math.max(lo, Math.min(hi, Math.round(v)));
        }
        var c = {
            untiled: eng.parseIndexList(KWin.readConfig("untiledDesktops", "")),
            gaps: {
                top: num("gapTop", 10, 0, 200), right: num("gapRight", 10, 0, 200),
                bottom: num("gapBottom", 10, 0, 200), left: num("gapLeft", 10, 0, 200),
            },
            between: num("gapBetween", 10, 0, 200),
            border: num("borderWidth", 3, 0, 16),
            radius: num("cornerRadius", 10, 0, 32),
            colour: String(KWin.readConfig("borderColor", "#3daee9")),
            limitsActive: String(KWin.readConfig("limitsActive", false)) === "true",
            defaultLimit: num("defaultLimit", 2, 1, 4),
            limits: eng.parseLimits(KWin.readConfig("limits", "")),
            floating: String(KWin.readConfig("floatingClasses", "com.maprisma.Launcher")).split(",")
                .map(function (s) { return s.trim().toLowerCase(); }).filter(function (s) { return s.length; }),
            layout: String(KWin.readConfig("defaultLayout", "dwindle")),
        };
        if (!/^#[0-9a-fA-F]{6}$/.test(c.colour)) c.colour = "#3daee9";
        var text = JSON.stringify(c);
        if (text === cfgText) return false;
        cfg = c;
        cfgText = text;
        return true;
    }

    function limitOf(index) { return cfg.limits[index] || cfg.defaultLimit; }

    // --- windows -------------------------------------------------------------

    // id -> {w, floating, pseudo, fill, maximized, group, floatGeom, savedWidth, surface}
    property var managed: ({})
    // group id -> {members: [window ids], active: window id}
    property var groups: ({})
    property int groupCount: 0
    // surface key (desktop id @ output name) -> engine surface
    property var surfaces: ({})
    readonly property int tabHeight: 26
    readonly property var ignoredClasses: ["plasmashell", "org.kde.plasmashell", "krunner", "org.kde.krunner",
        "spectacle", "org.kde.spectacle", "ksmserver-logout-greeter", "org.kde.polkit-kde-authentication-agent-1",
        "polkit-kde-authentication-agent-1", "kwin_wayland", "xwaylandvideobridge", "org.kde.ksplashqml", "yakuake"]

    function wid(w) { return String(w.internalId); }

    function eligible(w) {
        if (!w || w.deleted || w.popupWindow || !w.normalWindow || w.specialWindow) return false;
        // Panels, overlays (our own too) and other helpers keep out of every list.
        if (w.skipTaskbar && w.skipSwitcher) return false;
        var cls = String(w.resourceClass).toLowerCase();
        return ignoredClasses.indexOf(cls) < 0;
    }

    function floatsByItself(w) {
        if (w.modal || w.transient || w.dialog || w.splash || w.utility || !w.resizeable) return true;
        if (w.minSize && w.maxSize && w.maxSize.width > 0 && w.minSize.width === w.maxSize.width
            && w.minSize.height === w.maxSize.height) return true;
        var cls = String(w.resourceClass).toLowerCase(), app = String(w.desktopFileName).toLowerCase();
        return cfg.floating.indexOf(cls) >= 0 || cfg.floating.indexOf(app) >= 0;
    }

    function desktopIndex(d) { return Workspace.desktops.indexOf(d) + 1; }

    function tiledDesktop(d) { return !!d && cfg.untiled.indexOf(desktopIndex(d)) < 0; }

    // The surface a window tiles on, or null (floating, on all desktops, …).
    function surfaceKeyOf(info) {
        var w = info.w;
        if (info.floating || w.onAllDesktops || w.desktops.length !== 1 || !w.output) return null;
        if (!tiledDesktop(w.desktops[0])) return null;
        return w.desktops[0].id + "@" + w.output.name;
    }

    function surface(key) {
        if (!surfaces[key]) surfaces[key] = eng.newSurface(cfg.layout);
        return surfaces[key];
    }

    function tileOf(info) { return info.group || wid(info.w); }

    function activeInfo() {
        var w = Workspace.activeWindow;
        return w ? managed[wid(w)] || null : null;
    }

    // Puts the window's tile on the surface it belongs to now (or none). A
    // window that leaves its surface (other desktop or screen, floating)
    // leaves its group too.
    function place(info, activeTile) {
        var key = surfaceKeyOf(info);
        if (key === info.surface) return;
        if (info.surface && surfaces[info.surface]) {
            if (info.group) leaveGroup(info);
            eng.removeTile(surfaces[info.surface], wid(info.w));
            schedule(info.surface);
        }
        info.surface = key;
        if (key) {
            eng.addTile(surface(key), wid(info.w), activeTile || null);
            schedule(key);
        }
    }

    function manage(w) {
        if (managed[wid(w)] || !eligible(w)) return;
        var g = w.frameGeometry;
        var info = { w: w, floating: floatsByItself(w), pseudo: false, fill: false, maximized: false,
            group: null, floatGeom: { x: g.x, y: g.y, width: g.width, height: g.height }, savedWidth: 0, surface: null };
        managed[wid(w)] = info;
        var act = activeInfo();
        var activeTile = act && act.surface ? tileOf(act) : null;
        enforceLimit(info);
        place(info, activeTile);
        w.desktopsChanged.connect(function () { if (managed[wid(w)]) { place(info, null); } });
        w.outputChanged.connect(function () { if (managed[wid(w)]) place(info, null); });
        w.minimizedChanged.connect(function () { if (info.surface) schedule(info.surface); });
        w.fullScreenChanged.connect(function () { if (info.surface) schedule(info.surface); updateOverlay(); });
        w.maximizedAboutToChange.connect(function (mode) {
            info.maximized = mode !== 0;
            if (info.surface) schedule(info.surface);
        });
        w.captionChanged.connect(function () { if (info.group) updateOverlay(); });
        w.interactiveMoveResizeStarted.connect(function () {
            var f = w.frameGeometry;
            info.drag = { x: f.x, y: f.y, width: f.width, height: f.height };
        });
        w.interactiveMoveResizeFinished.connect(function () { dropped(info); });
        w.frameGeometryChanged.connect(function () {
            if (Workspace.activeWindow === w) updateOverlay();
        });
    }

    function unmanage(w) {
        var info = managed[wid(w)];
        if (!info) return;
        if (info.group) leaveGroup(info);
        else if (info.surface && surfaces[info.surface]) eng.removeTile(surfaces[info.surface], wid(w));
        if (info.surface) schedule(info.surface);
        delete managed[wid(w)];
        updateOverlay();
    }

    // --- the window limit ----------------------------------------------------

    // A new tiled window on a full desktop goes to the next desktop with room,
    // and the view follows it (Maprisma Theme's "Tiling active").
    function enforceLimit(info) {
        if (!cfg.limitsActive || info.floating) return;
        var w = info.w;
        if (w.onAllDesktops || w.desktops.length !== 1 || !tiledDesktop(w.desktops[0])) return;
        var counts = [0];
        Workspace.desktops.forEach(function (d) {
            var n = 0;
            Object.keys(surfaces).forEach(function (k) {
                if (k.indexOf(d.id + "@") === 0) n += surfaces[k].order.length;
            });
            counts.push(n);
        });
        var source = desktopIndex(w.desktops[0]);
        counts[source] += 1;
        var dest = eng.overflowTarget(source, counts, function (i) {
            return tiledDesktop(Workspace.desktops[i - 1]) ? limitOf(i) : 0;
        });
        if (!dest) return;
        var d = Workspace.desktops[dest - 1];
        w.desktops = [d];
        Workspace.currentDesktop = d;
        Workspace.activeWindow = w;
    }

    // --- layout --------------------------------------------------------------

    property var dirty: ({})
    property bool applying: false

    function schedule(key) {
        if (key) dirty[key] = true;
        relayoutTimer.restart();
    }

    Timer {
        id: relayoutTimer
        interval: 1
        onTriggered: {
            var keys = Object.keys(root.dirty);
            root.dirty = {};
            keys.forEach(root.relayout);
            root.updateOverlay();
        }
    }

    function scheduleAll() {
        Object.keys(surfaces).forEach(function (k) { dirty[k] = true; });
        relayoutTimer.restart();
    }

    function membersOf(tile) {
        return groups[tile] ? groups[tile].members.map(function (m) { return managed[m]; }).filter(Boolean)
            : (managed[tile] ? [managed[tile]] : []);
    }

    // A tile takes part while its (visible) window is there to see.
    function tileShown(tile) {
        var shown = groups[tile] ? managed[groups[tile].active] : managed[tile];
        return !!shown && !shown.w.minimized && !shown.w.deleted;
    }

    function areaOf(key) {
        var parts = key.split("@");
        var desk = null, out = null;
        Workspace.desktops.forEach(function (d) { if (d.id === parts[0]) desk = d; });
        Workspace.screens.forEach(function (o) { if (o.name === parts[1]) out = o; });
        if (!desk || !out) return null;
        return eng.inset(Workspace.clientArea(KWin.PlacementArea, out, desk), cfg.gaps);
    }

    // {tile: rect} of the surface as shown (tiles of hidden windows left out).
    function rectsOf(key) {
        var s = surfaces[key], area = areaOf(key);
        if (!s || !area) return { rects: {}, nodes: [], area: area, view: null };
        var view = { layout: s.layout, order: s.order.filter(tileShown), ratios: s.ratios, dirs: s.dirs };
        var out = eng.layout(view, area, cfg.between);
        out.area = area;
        out.view = view;
        return out;
    }

    function setGeometry(w, r) {
        var f = w.frameGeometry;
        if (f.x === r.x && f.y === r.y && f.width === r.width && f.height === r.height) return;
        w.frameGeometry = Qt.rect(r.x, r.y, r.width, r.height);
    }

    function relayout(key) {
        var lay = rectsOf(key);
        if (!lay.view) return;
        applying = true;
        lay.view.order.forEach(function (tile) {
            var r = lay.rects[tile];
            var members = membersOf(tile);
            if (groups[tile]) r = eng.rect(r.x, r.y + tabHeight, r.width, r.height - tabHeight);
            members.forEach(function (info) {
                var w = info.w;
                if (w.fullScreen || info.maximized || w.move || w.resize) return;
                var target = info.fill ? lay.area : r;
                if (info.pseudo) {
                    var pw = Math.min(info.floatGeom.width, target.width), ph = Math.min(info.floatGeom.height, target.height);
                    target = eng.rect(target.x + (target.width - pw) / 2, target.y + (target.height - ph) / 2, pw, ph);
                }
                setGeometry(w, target);
            });
            if (groups[tile] && managed[groups[tile].active]) raise(managed[groups[tile].active].w);
        });
        // monocle and "tiled full screen": the active one stays on top
        var act = activeInfo();
        if (act && act.surface === key && (act.fill || surfaces[key].layout === "monocle")) raise(act.w);
        applying = false;
    }

    function raise(w) {
        if (typeof Workspace.raiseWindow === "function") Workspace.raiseWindow(w);
    }

    // A tiled window was dragged or resized with the mouse.
    function dropped(info) {
        var key = info.surface, w = info.w, start = info.drag;
        info.drag = null;
        if (!key || !start || !surfaces[key]) { schedule(key); return; }
        var f = w.frameGeometry, s = surfaces[key], tile = tileOf(info);
        var lay = rectsOf(key);
        var resized = Math.abs(f.width - start.width) > 2 || Math.abs(f.height - start.height) > 2;
        if (resized) {
            var view = lay.view;
            if (Math.abs(f.width - start.width) > 2) {
                var leftMoved = Math.abs(f.x - start.x) > 2;
                eng.resize(view, lay.area, cfg.between, tile, "w", leftMoved ? start.x - f.x : f.width - start.width,
                    leftMoved ? "start" : "end");
            }
            if (Math.abs(f.height - start.height) > 2) {
                var topMoved = Math.abs(f.y - start.y) > 2;
                eng.resize(view, lay.area, cfg.between, tile, "h", topMoved ? start.y - f.y : f.height - start.height,
                    topMoved ? "start" : "end");
            }
        } else {
            var p = Workspace.cursorPos;
            var target = eng.tileAt(lay.rects, p.x, p.y, tile);
            if (target) eng.swapTiles(s, tile, target);
        }
        schedule(key);
    }

    // --- groups (tabs) -------------------------------------------------------

    function makeGroup(info) {
        var gid = "g" + (++groupCount);
        var s = info.surface ? surfaces[info.surface] : null;
        groups[gid] = { members: [wid(info.w)], active: wid(info.w) };
        if (s) {
            var i = s.order.indexOf(wid(info.w));
            if (i >= 0) s.order[i] = gid;
        }
        info.group = gid;
        return gid;
    }

    // The window leaves its group and becomes a tile of its own after it.
    function leaveGroup(info) {
        var gid = info.group, g = groups[gid];
        if (!g) { info.group = null; return; }
        var id = wid(info.w);
        g.members = g.members.filter(function (m) { return m !== id; });
        info.group = null;
        var s = info.surface ? surfaces[info.surface] : null;
        if (!g.members.length) {
            if (s) eng.removeTile(s, gid);
            delete groups[gid];
        } else if (g.active === id) {
            g.active = g.members[0];
        }
        if (s && managed[id] && s.order.indexOf(id) < 0) {
            var at = s.order.indexOf(gid);
            if (at >= 0) s.order.splice(at + 1, 0, id);
        }
    }

    function joinGroup(info, gid) {
        var g = groups[gid];
        if (!g || info.group === gid) return;
        var s = info.surface ? surfaces[info.surface] : null;
        if (info.group) leaveGroup(info);
        if (s) eng.removeTile(s, wid(info.w));
        g.members.push(wid(info.w));
        g.active = wid(info.w);
        info.group = gid;
    }

    function selectInGroup(gid, pick) {
        var g = groups[gid];
        if (!g || !g.members.length) return;
        var i = g.members.indexOf(g.active);
        var j = pick(i, g.members.length);
        if (j < 0 || j >= g.members.length) return;
        g.active = g.members[j];
        var info = managed[g.active];
        if (info) Workspace.activeWindow = info.w;
        schedule(info ? info.surface : null);
    }

    // --- actions (keys) ------------------------------------------------------

    function withActive(fn) {
        var info = activeInfo();
        if (info) fn(info);
    }

    // Visible windows of the current desktop by rect, for focus by direction:
    // tiles and floating windows alike.
    function visibleRects() {
        var out = {}, desk = Workspace.currentDesktop;
        Object.keys(managed).forEach(function (id) {
            var info = managed[id], w = info.w;
            if (w.minimized || !(w.onAllDesktops || w.desktops.indexOf(desk) >= 0)) return;
            if (info.group && groups[info.group].active !== id) return;
            var f = w.frameGeometry;
            out[id] = { x: f.x, y: f.y, width: f.width, height: f.height };
        });
        return out;
    }

    function focus(dir) {
        var act = Workspace.activeWindow;
        if (!act) return;
        var next = eng.neighbor(visibleRects(), wid(act), dir);
        if (next && managed[next]) Workspace.activeWindow = managed[next].w;
    }

    // Swaps with the tile that way; a floating window moves 100 px instead.
    function swap(dir) {
        withActive(function (info) {
            if (!info.surface) {
                var f = info.w.frameGeometry, d = 100;
                var dx = dir === "left" ? -d : dir === "right" ? d : 0, dy = dir === "up" ? -d : dir === "down" ? d : 0;
                info.w.frameGeometry = Qt.rect(f.x + dx, f.y + dy, f.width, f.height);
                return;
            }
            var lay = rectsOf(info.surface), tile = tileOf(info);
            var other = eng.neighbor(lay.rects, tile, dir);
            if (other && eng.swapTiles(surfaces[info.surface], tile, other)) schedule(info.surface);
        });
    }

    function toggleFloating() {
        withActive(function (info) {
            if (info.group) leaveGroup(info);
            if (info.surface && !info.floating) {
                info.floating = true;
                place(info, null);
                var g = info.floatGeom, area = Workspace.clientArea(KWin.PlacementArea, info.w.output, Workspace.currentDesktop);
                if (!g || g.width < 50) g = eng.rect(area.x + area.width * 0.2, area.y + area.height * 0.15, area.width * 0.6, area.height * 0.7);
                info.w.frameGeometry = Qt.rect(g.x, g.y, g.width, g.height);
            } else {
                var f = info.w.frameGeometry;
                info.floatGeom = { x: f.x, y: f.y, width: f.width, height: f.height };
                info.floating = false;
                place(info, null);
            }
            updateOverlay();
        });
    }

    function toggleFlag(flag) {
        withActive(function (info) {
            if (!info.surface) return;
            if (flag === "pseudo" && !info.pseudo) {
                var f = info.w.frameGeometry;
                if (!info.floatGeom || info.floatGeom.width < 50) info.floatGeom = { x: f.x, y: f.y, width: f.width * 0.8, height: f.height * 0.8 };
            }
            info[flag] = !info[flag];
            schedule(info.surface);
        });
    }

    function cycleLayout(step) {
        withActive(function (info) {
            if (!info.surface) return;
            eng.cycleLayout(surfaces[info.surface], step);
            schedule(info.surface);
        });
    }

    function toggleSplit() {
        withActive(function (info) {
            if (!info.surface) return;
            var lay = rectsOf(info.surface);
            if (eng.toggleSplit(lay.view, lay.area, cfg.between, tileOf(info))) schedule(info.surface);
        });
    }

    // Omarchy's resizeactive: axis "w"/"h", delta in pixels.
    function resizeActive(axis, delta) {
        withActive(function (info) {
            if (!info.surface) {
                var f = info.w.frameGeometry;
                info.w.frameGeometry = Qt.rect(f.x, f.y, Math.max(100, f.width + (axis === "w" ? delta : 0)),
                    Math.max(80, f.height + (axis === "h" ? delta : 0)));
                return;
            }
            var lay = rectsOf(info.surface);
            if (eng.resize(lay.view, lay.area, cfg.between, tileOf(info), axis, delta, null)) schedule(info.surface);
        });
    }

    function saveWidth() { withActive(function (info) { info.savedWidth = info.w.frameGeometry.width; }); }

    function restoreWidth() {
        withActive(function (info) {
            if (info.savedWidth > 0) resizeActive("w", info.savedWidth - info.w.frameGeometry.width);
        });
    }

    function toggleGroup() {
        withActive(function (info) {
            if (!info.surface) return;
            if (!info.group) { makeGroup(info); schedule(info.surface); return; }
            // Dissolve: every member a tile of its own again.
            var g = groups[info.group];
            g.members.slice().forEach(function (m) { if (managed[m]) leaveGroup(managed[m]); });
            schedule(info.surface);
        });
    }

    function moveOutOfGroup() {
        withActive(function (info) {
            if (!info.group) return;
            leaveGroup(info);
            schedule(info.surface);
        });
    }

    // Into the group (or window, which becomes a group) that way.
    function moveIntoGroup(dir) {
        withActive(function (info) {
            if (!info.surface) return;
            var lay = rectsOf(info.surface);
            var target = eng.neighbor(lay.rects, tileOf(info), dir);
            if (!target) return;
            var gid = groups[target] ? target : (managed[target] ? makeGroup(managed[target]) : null);
            if (!gid) return;
            joinGroup(info, gid);
            schedule(info.surface);
            Workspace.activeWindow = info.w;
        });
    }

    function groupStep(step) {
        withActive(function (info) {
            if (info.group) selectInGroup(info.group, function (i, n) { return (i + step + n) % n; });
        });
    }

    function groupPick(n) {
        withActive(function (info) {
            if (info.group) selectInGroup(info.group, function () { return n - 1; });
        });
    }

    // --- overlay: frame and tab bars -------------------------------------------

    property string sent: ""

    function frameOf(w) {
        var info = managed[wid(w)];
        if (!info || cfg.border <= 0 || w.fullScreen || w.minimized) return null;
        var d = w.onAllDesktops ? Workspace.currentDesktop : w.desktops[0];
        if (!tiledDesktop(d) || !(w.onAllDesktops || w.desktops.indexOf(Workspace.currentDesktop) >= 0)) return null;
        var f = w.frameGeometry;
        return { x: f.x, y: f.y, w: f.width, h: f.height, width: cfg.border, radius: cfg.radius };
    }

    function barsOf() {
        var bars = [], desk = Workspace.currentDesktop;
        Object.keys(groups).forEach(function (gid) {
            var g = groups[gid], top = managed[g.active];
            if (!top || !top.surface || top.w.minimized || top.w.fullScreen || top.w.desktops.indexOf(desk) < 0) return;
            var f = top.w.frameGeometry;
            bars.push({
                x: f.x, y: f.y - tabHeight, w: f.width, h: tabHeight - 2,
                tabs: g.members.map(function (m) {
                    return { title: managed[m] ? String(managed[m].w.caption) : "", active: m === g.active };
                }),
            });
        });
        return bars;
    }

    function updateOverlay() { overlayTimer.restart(); }

    Timer { id: overlayTimer; interval: 16; onTriggered: root.sendOverlay(false) }
    // Renewed every 10 s while something shows: a restarted helper gets it
    // back, and the helper drops what nobody renews (this script unloaded).
    Timer { interval: 10000; running: true; repeat: true; onTriggered: root.sendOverlay(true) }

    function sendOverlay(renew) {
        var act = Workspace.activeWindow;
        var msg = { frame: act ? frameOf(act) : null, bars: barsOf(), colour: cfg.colour };
        var text = JSON.stringify(msg);
        var shown = !!msg.frame || msg.bars.length > 0;
        if (text === sent && !(renew && shown)) return;
        if (renew && !shown && text === sent) return;
        sent = text;
        callOverlay(text);
    }

    function callOverlay(text) {
        DBus.SessionBus.asyncCall({
            service: "org.maprisma.TilingOverlay",
            path: "/org/maprisma/TilingOverlay",
            iface: "org.maprisma.TilingOverlay",
            member: "Set",
            arguments: [text],
            signature: "(s)",
        });
    }

    // --- keys --------------------------------------------------------------------

    // Omarchy's tiling keys (Maprisma's install.sh sets the keys that need
    // the German layout and moves conflicting KDE keys away).
    readonly property var shortcuts: [
        ["Focus Left", "Meta+Left", function () { root.focus("left"); }],
        ["Focus Right", "Meta+Right", function () { root.focus("right"); }],
        ["Focus Up", "Meta+Up", function () { root.focus("up"); }],
        ["Focus Down", "Meta+Down", function () { root.focus("down"); }],
        ["Swap Left", "Meta+Shift+Left", function () { root.swap("left"); }],
        ["Swap Right", "Meta+Shift+Right", function () { root.swap("right"); }],
        ["Swap Up", "Meta+Shift+Up", function () { root.swap("up"); }],
        ["Swap Down", "Meta+Shift+Down", function () { root.swap("down"); }],
        ["Toggle Floating", "Meta+T", function () { root.toggleFloating(); }],
        ["Tiled Full Screen", "Meta+Ctrl+F", function () { root.toggleFlag("fill"); }],
        ["Pseudo-tile", "Meta+P", function () { root.toggleFlag("pseudo"); }],
        ["Toggle Split", "Meta+J", function () { root.toggleSplit(); }],
        ["Next Layout", "Meta+L", function () { root.cycleLayout(1); }],
        ["Previous Layout", "Meta+Alt+L", function () { root.cycleLayout(-1); }],
        ["Save Width", "Meta+Alt+Home", function () { root.saveWidth(); }],
        ["Restore Width", "Meta+Home", function () { root.restoreWidth(); }],
        ["Width -100", "", function () { root.resizeActive("w", -100); }],
        ["Width +100", "", function () { root.resizeActive("w", 100); }],
        ["Height -100", "", function () { root.resizeActive("h", -100); }],
        ["Height +100", "", function () { root.resizeActive("h", 100); }],
        ["Width -25", "", function () { root.resizeActive("w", -25); }],
        ["Width +25", "", function () { root.resizeActive("w", 25); }],
        ["Height -25", "", function () { root.resizeActive("h", -25); }],
        ["Height +25", "", function () { root.resizeActive("h", 25); }],
        ["Width -300", "", function () { root.resizeActive("w", -300); }],
        ["Width +300", "", function () { root.resizeActive("w", 300); }],
        ["Height -300", "", function () { root.resizeActive("h", -300); }],
        ["Height +300", "", function () { root.resizeActive("h", 300); }],
        ["Toggle Group", "Meta+G", function () { root.toggleGroup(); }],
        ["Move Out of Group", "Meta+Alt+G", function () { root.moveOutOfGroup(); }],
        ["Move Into Group Left", "Meta+Alt+Left", function () { root.moveIntoGroup("left"); }],
        ["Move Into Group Right", "Meta+Alt+Right", function () { root.moveIntoGroup("right"); }],
        ["Move Into Group Up", "Meta+Alt+Up", function () { root.moveIntoGroup("up"); }],
        ["Move Into Group Down", "Meta+Alt+Down", function () { root.moveIntoGroup("down"); }],
        ["Next in Group", "Meta+Alt+Tab", function () { root.groupStep(1); }],
        ["Previous in Group", "Meta+Alt+Shift+Tab", function () { root.groupStep(-1); }],
        ["Next in Group (2)", "Meta+Ctrl+Right", function () { root.groupStep(1); }],
        ["Previous in Group (2)", "Meta+Ctrl+Left", function () { root.groupStep(-1); }],
        ["Group Window 1", "Meta+Alt+1", function () { root.groupPick(1); }],
        ["Group Window 2", "Meta+Alt+2", function () { root.groupPick(2); }],
        ["Group Window 3", "Meta+Alt+3", function () { root.groupPick(3); }],
        ["Group Window 4", "Meta+Alt+4", function () { root.groupPick(4); }],
        ["Group Window 5", "Meta+Alt+5", function () { root.groupPick(5); }],
    ]

    Instantiator {
        model: root.shortcuts
        delegate: ShortcutHandler {
            required property var modelData
            name: "Maprisma Tiling: " + modelData[0]
            text: "Maprisma Tiling: " + modelData[0]
            sequence: modelData[1]
            onActivated: modelData[2]()
        }
    }

    // --- events ------------------------------------------------------------------

    Connections {
        target: Workspace
        function onWindowAdded(w) { root.manage(w); }
        function onWindowRemoved(w) { root.unmanage(w); }
        function onWindowActivated(w) {
            var info = w ? root.managed[root.wid(w)] : null;
            // Alt+Tab to a hidden group member makes it the shown one.
            if (info && info.group && root.groups[info.group].active !== root.wid(w)) {
                root.groups[info.group].active = root.wid(w);
                root.schedule(info.surface);
            }
            root.updateOverlay();
        }
        function onCurrentDesktopChanged() { root.updateOverlay(); }
        function onScreensChanged() { root.scheduleAll(); }
        function onVirtualScreenGeometryChanged() { root.scheduleAll(); }
        function onDesktopsChanged() { root.scheduleAll(); }
    }

    // Settings: re-read after KWin reconfigures (Maprisma Theme does).
    Timer {
        interval: 2000; running: true; repeat: true
        onTriggered: {
            if (!root.readCfg()) return;
            Object.keys(root.managed).forEach(function (id) { root.place(root.managed[id], null); });
            root.scheduleAll();
        }
    }

    Component.onCompleted: {
        readCfg();
        Workspace.stackingOrder.forEach(manage);
        scheduleAll();
    }

    Component.onDestruction: {
        if (sent !== "") callOverlay(JSON.stringify({ frame: null, bars: [], colour: cfg.colour }));
    }
}
