#!/usr/bin/env python3
"""maprisma-tiling-overlay: draws for the Maprisma Tiling KWin script what
KWin scripts cannot draw at the right scale: the active window's frame and
the tab bars of window groups.

The script sends the whole picture over D-Bus (org.maprisma.TilingOverlay,
method Set with a JSON string, logical pixels):
  {"frame": {x, y, w, h, width, radius} | null,
   "bars": [{x, y, w, h, tabs: [{title, active}]}],
   "colour": "#rrggbb"}
and this draws it on a transparent layer-shell overlay that takes no input.
Started by D-Bus activation on the first call; anything not renewed for 35 s
is dropped (the script renews every 10 s, so it was unloaded), and the helper
quits after 10 minutes with nothing to show.

Needs gtk4-layer-shell, loaded before libwayland (LD_PRELOAD, see the
D-Bus service file).
"""
import json
import math
import sys

import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Gdk', '4.0')
gi.require_version('Gtk4LayerShell', '1.0')
gi.require_version('Pango', '1.0')
gi.require_version('PangoCairo', '1.0')
from gi.repository import Gdk, Gio, GLib, Gtk, Pango, PangoCairo, Gtk4LayerShell as Layer  # noqa: E402
import cairo  # noqa: E402

NAME = 'org.maprisma.TilingOverlay'
PATH = '/org/maprisma/TilingOverlay'
XML = f'''<node><interface name="{NAME}">
  <method name="Set"><arg type="s" name="picture" direction="in"/></method>
</interface></node>'''
IDLE_QUIT_S = 600
STALE_S = 35
EMPTY = {'frame': None, 'bars': [], 'colour': '#3daee9'}


def number(v):
    return isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v)


def clean(text):
    """The picture from the script, checked; EMPTY when it is not one."""
    try:
        p = json.loads(text)
    except ValueError:
        return EMPTY
    if not isinstance(p, dict):
        return EMPTY
    out = {'frame': None, 'bars': [], 'colour': '#3daee9'}
    rgba = Gdk.RGBA()
    if isinstance(p.get('colour'), str) and rgba.parse(p['colour']):
        out['colour'] = p['colour']
    f = p.get('frame')
    if isinstance(f, dict) and all(number(f.get(k)) for k in ('x', 'y', 'w', 'h')):
        out['frame'] = {k: f[k] for k in ('x', 'y', 'w', 'h')}
        out['frame']['width'] = max(1, min(16, int(f.get('width', 3)) if number(f.get('width')) else 3))
        out['frame']['radius'] = max(0, min(32, f.get('radius', 10) if number(f.get('radius')) else 10))
    for b in p.get('bars') or []:
        if not (isinstance(b, dict) and all(number(b.get(k)) for k in ('x', 'y', 'w', 'h'))):
            continue
        tabs = [{'title': str(t.get('title', ''))[:200], 'active': bool(t.get('active'))}
                for t in (b.get('tabs') or [])[:16] if isinstance(t, dict)]
        if tabs:
            out['bars'].append({'x': b['x'], 'y': b['y'], 'w': b['w'], 'h': b['h'], 'tabs': tabs})
        if len(out['bars']) >= 32:
            break
    return out


def rounded(cr, x, y, w, h, r):
    r = max(0.0, min(r, w / 2, h / 2))
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


class Overlay:
    def __init__(self, app):
        self.app = app
        self.picture = EMPTY
        self.windows = {}  # monitor -> (window, area)
        self.idle = None
        self.renewed = GLib.get_monotonic_time()
        GLib.timeout_add_seconds(5, self.check_stale)
        monitors = Gdk.Display.get_default().get_monitors()
        monitors.connect('items-changed', lambda *_: self.sync_monitors())
        self.sync_monitors()
        self.arm_idle()

    def shown(self):
        return bool(self.picture['frame'] or self.picture['bars'])

    def sync_monitors(self):
        monitors = Gdk.Display.get_default().get_monitors()
        present = [monitors.get_item(i) for i in range(monitors.get_n_items())]
        for m in list(self.windows):
            if m not in present:
                self.windows.pop(m)[0].destroy()
        for m in present:
            if m not in self.windows:
                self.windows[m] = self.make(m)

    def make(self, monitor):
        win = Gtk.Window(application=self.app)
        win.set_decorated(False)
        win.add_css_class('maprisma-tiling-overlay')
        Layer.init_for_window(win)
        Layer.set_namespace(win, 'maprisma-tiling-overlay')
        Layer.set_layer(win, Layer.Layer.OVERLAY)
        Layer.set_monitor(win, monitor)
        for edge in (Layer.Edge.TOP, Layer.Edge.BOTTOM, Layer.Edge.LEFT, Layer.Edge.RIGHT):
            Layer.set_anchor(win, edge, True)
        Layer.set_exclusive_zone(win, -1)
        Layer.set_keyboard_mode(win, Layer.KeyboardMode.NONE)
        area = Gtk.DrawingArea()
        area.set_draw_func(self.draw, monitor)
        win.set_child(area)
        win.connect('realize', self.no_input)
        win.connect('map', self.no_input)
        win.present()
        win.set_visible(self.shown())
        return win, area

    @staticmethod
    def no_input(win):
        surface = win.get_surface()
        if surface is not None:
            surface.set_input_region(cairo.Region())

    def draw(self, area, cr, width, height, monitor):
        g = monitor.get_geometry()
        rgba = Gdk.RGBA()
        rgba.parse(self.picture['colour'])
        for bar in self.picture['bars']:
            self.draw_bar(area, cr, bar, g, rgba)
        f = self.picture['frame']
        if f:
            self.draw_frame(cr, f, g, width, height, rgba)

    @staticmethod
    def draw_frame(cr, f, g, width, height, rgba):
        bw = f['width']
        # Clipped to this monitor: a window reaching past the screen edge
        # still shows all four sides.
        left = max(0.0, f['x'] - g.x)
        top = max(0.0, f['y'] - g.y)
        right = min(float(width), f['x'] - g.x + f['w'])
        bottom = min(float(height), f['y'] - g.y + f['h'])
        if right - left < 2 * bw or bottom - top < 2 * bw:
            return
        # The window's corner radius is its outer edge; the stroke runs bw/2
        # inside it, so its curve follows the window's own.
        r = max(0.0, f['radius'] - bw / 2)
        cr.set_source_rgba(rgba.red, rgba.green, rgba.blue, 1.0)
        cr.set_line_width(bw)
        rounded(cr, left + bw / 2, top + bw / 2, right - left - bw, bottom - top - bw, r)
        cr.stroke()

    @staticmethod
    def draw_bar(area, cr, bar, g, rgba):
        x, y, w, h = bar['x'] - g.x, bar['y'] - g.y, bar['w'], bar['h']
        tabs = bar['tabs']
        gap = 4
        tw = (w - gap * (len(tabs) - 1)) / len(tabs)
        layout = area.create_pango_layout('')
        font = Pango.FontDescription.from_string('Sans 9')
        layout.set_font_description(font)
        layout.set_ellipsize(Pango.EllipsizeMode.END)
        for i, tab in enumerate(tabs):
            tx = x + i * (tw + gap)
            rounded(cr, tx, y, tw, h, 6)
            if tab['active']:
                cr.set_source_rgba(rgba.red, rgba.green, rgba.blue, 0.95)
            else:
                cr.set_source_rgba(0.12, 0.12, 0.14, 0.85)
            cr.fill()
            # Text in black on a light accent, else white.
            light = tab['active'] and (0.299 * rgba.red + 0.587 * rgba.green + 0.114 * rgba.blue) > 0.6
            cr.set_source_rgba(*((0.05, 0.05, 0.05, 1) if light else (0.95, 0.95, 0.95, 1)))
            layout.set_text(tab['title'] or '—', -1)
            layout.set_width(int(max(10, tw - 16) * Pango.SCALE))
            _, th = layout.get_pixel_size()
            cr.move_to(tx + 8, y + (h - th) / 2)
            PangoCairo.show_layout(cr, layout)

    def set(self, text):
        self.picture = clean(text)
        self.renewed = GLib.get_monotonic_time()
        shown = self.shown()
        for win, area in self.windows.values():
            win.set_visible(shown)
            if shown:
                self.no_input(win)
                area.queue_draw()
        if shown:
            self.arm_idle()

    def check_stale(self):
        if self.shown() and GLib.get_monotonic_time() - self.renewed > STALE_S * 1_000_000:
            self.set(json.dumps(EMPTY))
        return True

    def arm_idle(self):
        if self.idle:
            GLib.source_remove(self.idle)
        self.idle = GLib.timeout_add_seconds(IDLE_QUIT_S, self.quit_if_idle)

    def quit_if_idle(self):
        self.idle = None
        if not self.shown():
            self.app.quit()
            return False
        self.arm_idle()
        return False


def main():
    app = Gtk.Application(application_id='org.maprisma.TilingOverlayApp', flags=Gio.ApplicationFlags.NON_UNIQUE)
    state = {}

    def on_call(conn, sender, path, iface, method, params, invocation):
        if method == 'Set' and 'overlay' in state:
            state['overlay'].set(params.unpack()[0])
        invocation.return_value(None)

    def activate(app):
        app.hold()
        state['overlay'] = Overlay(app)
        bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        info = Gio.DBusNodeInfo.new_for_xml(XML).interfaces[0]
        bus.register_object(PATH, info, on_call, None, None)
        # DoNotQueue: a second copy gives up instead of waiting for the name.
        reply = bus.call_sync('org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus',
                              'RequestName', GLib.Variant('(su)', (NAME, 4)), GLib.VariantType('(u)'),
                              Gio.DBusCallFlags.NONE, -1, None).unpack()[0]
        if reply not in (1, 4):
            print('another overlay owns', NAME, file=sys.stderr)
            app.quit()
        css = Gtk.CssProvider()
        css.load_from_string('window.maprisma-tiling-overlay { background: transparent; }')
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    app.connect('activate', activate)
    return app.run([])


if __name__ == '__main__':
    sys.exit(main())
